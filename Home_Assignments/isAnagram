function isAnagram(str1, str2) {

    // Get lengths of both strings
    let n1 = string1.length;
    let n2 = string2.length;

    //Convert the string into Lowercase if 
    let string1 = str1.replace(/\s/g, "").toLowerCase();
    let string2 = str2.replace(/\s/g, "").toLowerCase();

    // If length of both strings is not 
    // same, then they cannot be anagram
    if (n1 != n2)
        return false;

    let sorted1 = string1.split("").sort().join("");
    let sorted2 = string2.split("").sort().join("");

    console.log(sorted1);
    console.log(sorted2);

    return sorted1 === sorted2;
}

console.log(isAnagram("listen", "silent"));
// Output: true

console.log(isAnagram("hello", "world"));
// Output: false

